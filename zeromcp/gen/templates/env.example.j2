# Database — {% if creds %}populated by `0-mcp init`{% else %}fill in for your environment{% endif %}.
DB_NAME={{ creds.db_name if creds else config.project.database }}
DB_HOST={{ creds.db_host if creds else 'localhost' }}
DB_USER={{ creds.db_user if creds else '' }}
DB_PASSWORD={{ creds.db_password if creds else '' }}
DB_PORT={{ creds.db_port if creds else (5432 if config.project.backend == 'postgres' else 3306) }}

# Redis (used for sessions, cache, rate limit).
REDIS_SERVER=localhost
REDIS_DB=0
REDIS_PREFIX={{ config.project.name }}

# Generated with `0-mcp init` — demo-friendly defaults so the project
# runs out of the box. Before deploying:
#   - flip DEBUG to false
#   - set ALLOWED_HOSTS to your real hostnames (comma-separated)
#   - rotate DJANGO_SECRET_KEY
#   - tighten the MCP endpoint (see router/urls.py)
DJANGO_SECRET_KEY=change-me
DEBUG=true
# ALLOWED_HOSTS=app.example.com,api.example.com
