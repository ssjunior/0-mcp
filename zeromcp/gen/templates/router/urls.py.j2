"""URL configuration — generated by `0-mcp init`.

Demo-friendly defaults: the MCP endpoint, the REST surface and the
docs are exposed without auth so the project boots out of the box.
**Before deploying**, drop ``mcp_kwargs`` and ``docs_public``:

    urlpatterns = get_routes(endpoints, mcp=True)

…which restores ``X-Api-Key`` gating on the MCP route and the docs.
"""
from zeromcp import get_routes

from .endpoints import endpoints


urlpatterns = get_routes(
    endpoints,
    mcp=True,
    docs_public=True,
    mcp_kwargs={'authenticated': False},
)
