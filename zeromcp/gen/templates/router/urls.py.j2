"""URL configuration — generated by `0-mcp init`.

Demo-friendly defaults: the MCP endpoint and the docs are exposed
without auth so the project boots and runs out of the box. **Before
deploying** this beyond your local machine, harden the MCP route:

    # Replace the demo block below with a single line that gates on
    # the same X-Api-Key as the REST surface:
    urlpatterns = get_routes(endpoints, mcp=True, docs_public=False)
"""
from django.urls import path

from zeromcp import get_routes
from zeromcp.mcp.resource import mcp_view

from .endpoints import endpoints


urlpatterns = get_routes(endpoints, mcp=False, docs_public=True) + [
    path('mcp', mcp_view(endpoints, authenticated=False)),
]
