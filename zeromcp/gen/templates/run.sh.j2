#!/usr/bin/env bash
# Generated by `0-mcp init`. Brings the project up — installs on first
# run, otherwise just starts the dev server. Uses ``uv run`` so the
# parent shell never gets the venv activated.
set -e

cd "$(dirname "$0")"

if ! command -v uv >/dev/null 2>&1; then
  echo 'error: uv is required.'
  echo '  install with: curl -LsSf https://astral.sh/uv/install.sh | sh'
  exit 1
fi

if [ ! -d .venv ]; then
  echo '→ creating virtual environment with uv'
  uv venv
fi

# Explicit target. Without this, ``uv pip install`` picks up whatever
# venv is currently active in the parent shell (pyenv-virtualenv,
# conda, etc.) — and silently installs there instead of into .venv.
export VIRTUAL_ENV="$(pwd)/.venv"

# A sentinel file marks "deps already installed" so re-runs skip the
# slow path. Delete .venv/.installed (or .venv entirely) to force a
# fresh install — useful after editing requirements.txt.
if [ ! -f .venv/.installed ] || [ requirements.txt -nt .venv/.installed ]; then
  echo '→ installing dependencies'
  uv pip install -r requirements.txt --python "$VIRTUAL_ENV/bin/python"
  touch .venv/.installed
fi

if [ ! -f .env ]; then
  echo 'error: no .env file found. Re-run `0-mcp init` to regenerate it,'
  echo '       or copy .env.example and fill in credentials manually.'
  exit 1
fi

{% if config.project.django_managed %}
# First-run migration: generate the initial migration files for every
# generated module, then ``--fake-initial`` so Django records them as
# applied without trying to recreate the existing database tables.
# After this the project behaves like any other Django app —
# ``makemigrations`` + ``migrate`` work normally for new fields.
if [ ! -f .venv/.migrated ]; then
  echo '→ priming migrations (fake-initial)'
  "$VIRTUAL_ENV/bin/python" manage.py makemigrations >/dev/null
  "$VIRTUAL_ENV/bin/python" manage.py migrate --fake-initial
  touch .venv/.migrated
fi
{% endif %}

echo '→ starting Django dev server'
# Call the venv's python directly. ``uv run`` would auto-detect a
# parent ``pyproject.toml`` and pick the wrong environment when this
# project sits inside an editable framework checkout — the explicit
# path keeps things deterministic.
exec "$VIRTUAL_ENV/bin/python" manage.py runserver "${@:-0.0.0.0:8000}"
