"""Environment variables — read once, fail fast on missing.

Auto-loads ``.env`` from the project root if present, so ``runserver``
works without a separate ``source .env`` step (and with shells that
don't support ``source`` on KEY=VALUE files, like fish).
"""
import os
from pathlib import Path


def _load_dotenv() -> None:
    """Minimal ``.env`` loader: line-by-line ``KEY=VALUE``, ignoring
    blanks and ``#`` comments. Existing env vars take precedence — the
    file is a default, never an override."""
    path = Path(__file__).resolve().parent.parent / '.env'
    if not path.is_file():
        return
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        if '=' not in line:
            continue
        key, _, value = line.partition('=')
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        os.environ.setdefault(key, value)


_load_dotenv()


DEBUG = os.environ.get('DEBUG', 'false').lower() == 'true'
SECRET_KEY = os.environ.get('DJANGO_SECRET_KEY', 'change-me')

DB_NAME = os.environ['DB_NAME']
DB_HOST = os.environ['DB_HOST']
DB_USER = os.environ['DB_USER']
DB_PASSWORD = os.environ['DB_PASSWORD']
DB_PORT = int(os.environ.get('DB_PORT', {% if config.project.backend == 'postgres' %}5432{% else %}3306{% endif %}))

REDIS_SERVER = os.environ.get('REDIS_SERVER', 'localhost')
REDIS_DB = int(os.environ.get('REDIS_DB', 0))
REDIS_PREFIX = os.environ.get('REDIS_PREFIX', '{{ config.project.name }}')
