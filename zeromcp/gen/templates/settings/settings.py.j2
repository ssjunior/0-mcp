    # 'MCP_API_KEY_RESOLVER': None,         # 'pkg.mod.func'

    # ── Anti-CSRF (browser cookie auth) ──────────────────────────────
    # Set at least one of the two before deploying. Without either,
    # the framework logs a startup warning whenever
    # ``DEFAULT_AUTHENTICATED`` is on.
    # ENFORCE_TOKEN=True forces every state-changing request to carry
