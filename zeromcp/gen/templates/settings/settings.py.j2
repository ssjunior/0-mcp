"""Settings for {{ config.project.name }} — generated by `0-mcp init`."""
from .env import (
    DEBUG, SECRET_KEY,
    DB_NAME, DB_HOST, DB_USER, DB_PASSWORD, DB_PORT,
    REDIS_SERVER, REDIS_DB, REDIS_PREFIX,  # noqa
)

ROOT_URLCONF = 'router.urls'

# In DEBUG mode any Host header is accepted (local dev, ngrok, ...).
# When DEBUG is off, read ALLOWED_HOSTS from the env (comma-separated)
# and default to common local entries so the dev server still boots.
import os as _os
ALLOWED_HOSTS = (
    ['*'] if DEBUG
    else [h.strip() for h in _os.environ.get(
        'ALLOWED_HOSTS', 'localhost,127.0.0.1,0.0.0.0',
    ).split(',') if h.strip()]
)

INSTALLED_APPS = [
{% for module_name in modules %}
    'modules.{{ module_name }}',
{% endfor %}
]

MIDDLEWARE = [
    'zeromcp.SecurityMiddleware',
    'zeromcp.AuthMiddleware',
    'zeromcp.ExceptionMiddleware',
]

DATABASES = {
    'default': {
        {% if config.project.backend == 'postgres' %}
        'ENGINE': 'django.db.backends.postgresql',
        {% else %}
        'ENGINE': 'django.db.backends.mysql',
        {% endif %}
        'NAME': DB_NAME,
        'HOST': DB_HOST,
        'USER': DB_USER,
        'PASSWORD': DB_PASSWORD,
        'PORT': DB_PORT,
    },
}

DEFAULT_AUTO_FIELD = 'django.db.models.BigAutoField'

USE_TZ = True
TIME_ZONE = 'UTC'

# 0-mcp framework settings — see https://github.com/ssjunior/0-mcp
MCP = {
    'COOKIE_ID': 'sessionid',
    'TOKEN_MAX_DRIFT_MS': 30000,
    'ENFORCE_TOKEN': False,
    # Demo-friendly: every BaseResource subclass starts with auth off
    # so the project boots without a configured api-key resolver.
    # Flip to ``True`` and configure ``TENANT_USER_API_MODEL`` (or set
    # ``authenticated = True`` per resource) before deploying.
    'DEFAULT_AUTHENTICATED': False,
    # Sliding TTLs (seconds) for cached sessions. Each authenticated
    # request renews the TTL via Redis ``GETEX`` — idle keys expire
    # naturally after the window.
    # 'SESSION_TTL': 1800,         # cookie session (default 30 min)
    # 'API_SESSION_TTL': 300,      # api-key session cache (default 5 min)
    # Anti-CSRF for cookie auth — set at least one of the two:
    #   - ``ENFORCE_TOKEN = True`` enables HMAC anti-replay (X-Token).
    #   - ``ALLOWED_ORIGINS`` enforces an Origin allowlist.
    # Without either, the framework logs a startup warning.
    # 'ALLOWED_ORIGINS': ['app.example.com'],
    # 'TRUSTED_PROXIES': ['10.0.0.0/8'],
    # 'CACHE_TTL': 60,
}

# API-key authentication. Point this at the Django model that stores
# the per-user api keys (column name expected: ``api_key``). When set,
# ``X-Api-Key`` requests are resolved to the matching row by the
# default resolver — no multi-tenant database switching required.
{% if api_key_model %}
TENANT_USER_API_MODEL = '{{ api_key_model }}'
{% else %}
# TENANT_USER_API_MODEL = 'user.User'
{% endif %}
