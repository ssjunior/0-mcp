    # tighter replay protection but more 4xx on devices with bad clocks.
    # 'TOKEN_MAX_DRIFT_MS': 30000,          # 30s
    # 'SESSION_TTL': 1800,                  # cookie session sliding window in seconds (30 min)
    # 'API_SESSION_TTL': 300,               # api-key session cache sliding window in seconds (5 min)
    # Override the api-key resolver when your keys aren't a column in
